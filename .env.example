# Copy to .env and fill in. Real keys never belong in the repository.

# Any OpenAI-compatible endpoint works; these two are the built-in defaults.
OPENAI_API_KEY="sk-..."
DEEPSEEK_API_KEY="sk-..."

# Optional: overrides the apiKey from .translator-sync.json
TRANSLATOR_API_KEY=""

# Optional: point at a self-hosted or third-party endpoint
# TRANSLATOR_BASE_URL="https://api.tokenfactory.nebius.com/v1"
# TRANSLATOR_MODEL="deepseek-ai/DeepSeek-V3"

LOG_LEVEL="info" # debug | info | warn | error
