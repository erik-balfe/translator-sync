{
  "name": "translator-sync",
  "version": "1.0.0",
  "description": "Automate React/Vue i18n translation workflow with AI. Sync translation files automatically, reduce costs 50,000x vs services. Works with react-i18next, vue-i18n, JSON, Fluent.",
  "keywords": [
    "react-i18n",
    "vue-i18n",
    "i18next",
    "translation-automation",
    "localization-tool",
    "i18n-workflow",
    "translation-sync",
    "react-translation",
    "vue-translation",
    "i18n-cli",
    "translation-cli",
    "automated-translation",
    "i18n",
    "translation",
    "localization",
    "react",
    "vue",
    "nextjs",
    "ai",
    "openai"
  ],
  "homepage": "https://github.com/erik-balfe/translator-sync",
  "bugs": "https://github.com/erik-balfe/translator-sync/issues",
  "license": "MIT",
  "author": "Erik Balfe",
  "type": "module",
  "main": "./dist/index.js",
  "exports": "./dist/index.js",
  "bin": {
    "translator-sync": "./dist/cli/translator-sync.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "prepublishOnly": "bun run build",
    "check": "bun run type-check && bun test",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:coverage": "bun test --coverage",
    "type-check": "tsc --noEmit",
    "release:major": "bun scripts/release.ts major",
    "release:minor": "bun scripts/release.ts minor",
    "release:patch": "bun scripts/release.ts patch"
  },
  "devDependencies": {
    "@fluent/syntax": "^0.19.0",
    "@types/bun": "latest",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
